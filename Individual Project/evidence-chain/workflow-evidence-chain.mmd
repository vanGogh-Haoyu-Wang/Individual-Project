        W7["R260_2: streaming ZIP/XML exploratory analysis"]
    end

    subgraph V["Verification"]
        V1["MATLAB CT07 oracle\n1,807 mechanical + 5,850 AE"]
        V2["MATLAB Legacy T01 oracle\n3,098 rows"]
        V3["MATLAB Adaptive / Top-3 oracle\nT01-T09"]
        V4["Public Python DTA oracle\n8 hits + 8 waveforms"]
        V5["MATLAB WFS oracle\n2 × 103,424 samples"]
        V6["No raw-waveform oracle\ninput-hash and schema checks only"]
    end

    subgraph C["Defensible Thesis Claims"]
        C1["CT07 migration evidence\nOriginal success ≠ final validated runner"]
        C2["SMOP deterministic baseline\nRecoverable, not automatic"]
        C3["Legacy three-language validation\nComplete T01 only"]
        C4["Adaptive / Top-3 numerical agreement\nSecondary descriptive role"]
        C5["DTA format/workflow applicability\nOne tested variant"]
        C6["WFS single-fixture validation\nMaterial unknown"]
        C7["R260_2 exploratory hit-level case\nProvenance and units limited"]
    end

